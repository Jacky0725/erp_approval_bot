ERP_URL=https://example.com/login
ERP_USERNAME=your_username
ERP_PASSWORD=your_password
LLM_PROVIDER=siliconflow
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
# Backward-compatible SiliconFlow aliases. Leave blank unless older scripts need them.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
SILICONFLOW_MODEL=
JIANGUOYUN_WEBDAV_USER=
JIANGUOYUN_WEBDAV_PASSWORD=
TARGET_LIST_NUMBERS=
PROCESS_ALL_TODOS=false
PROCESS_ALL_TODOS_MAX=50
APP_DRY_RUN=true
APPROVAL_WRITE_MODE=disabled
APPROVAL_WRITE_MIN_CONFIDENCE=0.8
APPROVAL_PARALLEL_WORKERS=3
AUTO_PASS=false
# Alibaba Model Studio V3 Responses/web_search (keep the real value in .env only)
DASHSCOPE_API_KEY=
# V1 missing-CAS identity enrichment uses the same key with qwen3.7-flash.
# It is a candidate generator only; external chemical sources verify identity.
